# Copy to .env before `docker compose up`. .env is gitignored.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=katrina
POSTGRES_PASSWORD=change_me_in_dev_only
POSTGRES_DB=katrina_events_development

# --- Rails ------------------------------------------------------------------
RAILS_ENV=development
# Signs the auth tokens. Kept separate from secret_key_base so rotating it logs
# everyone out without invalidating anything else Rails signs. Generate with:
#   docker compose exec api bin/rails secret
DEVISE_JWT_SECRET_KEY=generate_your_own_do_not_use_this_value
RAILS_MAX_THREADS=5
# Origins allowed to call /api in development. Production sends no CORS headers.
CORS_ORIGINS=http://localhost:3001

# --- Katrina's account (seeded; there is no signup surface) ------------------
# Her real address is still an open question (plan §11.1). The default is a
# .invalid domain, which RFC 2606 reserves so it can never reach a real inbox.
KATRINA_NAME=Katrina
KATRINA_EMAIL=katrina@example.invalid
KATRINA_PASSWORD=change-me-in-development

# --- Frontend ---------------------------------------------------------------
# Empty means same-origin (production, behind nginx). Development points at Rails.
API_BASE_URL=http://localhost:3000
